# ShiftReady UI - Local Development Environment
# Copy this file to .env.local and fill in the values.

# Backend API base URL (no trailing slash)
# Default when unset: http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Temporary dev user ID - used before Firebase Auth is integrated (Phase 1).
# Remove once authentication is wired up.
NEXT_PUBLIC_DEV_USER_ID=dev_user

# --- Phase 1: Firebase Authentication (uncomment when implementing auth) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
