    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.52.0",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-query-devtools": "^5.99.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-intl": "^4.11.1",
    "posthog-js": "^1.372.10",
    "posthog-node": "^5.21.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
