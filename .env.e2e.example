# Copy to .env.e2e and fill in values before running: make test-e2e

# App URL (prod or local dev server)
E2E_BASE_URL=https://shiftready-ui-7nkqrak2ta-ts.a.run.app

# Backend API URL
E2E_API_URL=https://shiftready-api-7nkqrak2ta-ts.a.run.app

# Firebase API key (NEXT_PUBLIC_FIREBASE_API_KEY from .env.local)
E2E_FIREBASE_API_KEY=

# Test accounts — create these manually in Firebase Auth console
# Seller: must have at least one published sale for offer/sold tests
E2E_SELLER_EMAIL=
E2E_SELLER_PASSWORD=

# Buyer: a separate account used to browse and make offers
E2E_BUYER_EMAIL=
E2E_BUYER_PASSWORD=
