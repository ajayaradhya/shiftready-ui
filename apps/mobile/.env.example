EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google Sign-In OAuth client IDs
# iOS: Google Cloud Console → Credentials → OAuth 2.0 → iOS client (bundle: au.com.shiftready.app)
# Android: Google Cloud Console → Credentials → OAuth 2.0 → Android client (package: au.com.shiftready.app)
# Web: Firebase Console → Auth → Google → Web SDK configuration → Web client ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=   # from GoogleService-Info.plist → CLIENT_ID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional: override the dev bypass user ID
# EXPO_PUBLIC_DEV_USER_ID=dev_user
